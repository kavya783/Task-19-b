
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>Order Invoice</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      margin: 30px;
      color: #333333;
      font-size: 14px;
      font-weight: 400;
      line-height: 1.6;
    }

    .invoice-container {
      max-width: 850px;
      margin: 0 auto;
      padding: 30px;
      border: 1px solid #dddddd;
      border-radius: 8px;
      background-color: #ffffff;
    }

    h1 {
      text-align: center;
      color: #4b7c35;
      font-size: 28px;
      font-weight: 700;
      margin-bottom: 5px;
    }

    .subtitle {
      text-align: center;
      font-size: 18px;
      font-weight: 700;
      margin-top: 0;
      margin-bottom: 30px;
    }
    .invoice-label {
  font-family: Arial, Helvetica, sans-serif;
  font-size: 18px;
  font-weight: 900 !important;
  color: #222222;
  margin-bottom: 4px;
}

.invoice-value {
  font-size: 15px;
  font-weight: 700 !important;
  margin-top: 0;
}

    /* Force labels to appear bold */
    strong,
    b,
    .label {
      font-family: Arial, Helvetica, sans-serif;
      font-weight: 700 !important;
      color: #222222;
    }

    .order-details p {
      margin: 10px 0;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 25px;
      margin-bottom: 25px;
    }

    th,
    td {
      border: 1px solid #cccccc;
      padding: 12px;
      text-align: left;
      font-size: 14px;
    }

    th {
      background-color: #4b7c35;
      color: #ffffff;
      font-weight: 700 !important;
    }

    tbody tr:nth-child(even) {
      background-color: #f7f9f5;
    }

    .total {
      text-align: right;
      margin-top: 25px;
      font-size: 20px;
      font-weight: 700 !important;
      color: #4b7c35;
    }

    .footer {
      text-align: center;
      margin-top: 35px;
      padding-top: 15px;
      border-top: 1px solid #dddddd;
      font-size: 12px;
      color: #666666;
    }

    @media print {
      body {
        margin: 0;
      }

      .invoice-container {
        border: none;
        border-radius: 0;
        padding: 15px;
      }

      th {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
    }

    @media (max-width: 600px) {
      body {
        margin: 10px;
      }

      .invoice-container {
        padding: 12px;
      }

      th,
      td {
        padding: 7px;
        font-size: 12px;
      }

      h1 {
        font-size: 23px;
      }
    }
  </style>
</head>

<body>
  <div class="invoice-container">

    <h1>MAMAEARTH</h1>
    <p class="subtitle">ORDER INVOICE</p>

   <div class="invoice-label">
  <p>
  <strong>ID:</strong>
    <%= @order.txnid.presence || @order.id %>
 </p>
    <p>
        <strong>Order Date:</strong>
        <%= @order.created_at.strftime("%d-%m-%Y") %>
      </p>
       <p>
        <strong>Order Status:</strong>
        <%= @order.status.to_s.humanize %>
      </p>

</div>
    <table>
      <thead>
        <tr>
          <th>Product</th>
          <th>Quantity</th>
          <th>Price (₹)</th>
        </tr>
      </thead>

      <tbody>
        <% @order.items_data.each do |item| %>
          <tr>
            <td>
              <%= item["heading"].presence ||
                  item["name"].presence ||
                  item["title"].presence ||
                  "Product" %>
            </td>

            <td>
              <%= item["quantity"].to_i > 0 ? item["quantity"].to_i : 1 %>
            </td>

            <td>
              ₹<%= item["sale_price"].presence ||
                   item["price"].presence ||
                   item["discount_price"].presence ||
                   item["mrp"] || 0 %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <h3 class="total">
      Total: ₹<%= @order.amount %>
    </h3>

    <div class="footer">
      Thank you for shopping with Mamaearth!
    </div>

  </div>
</body>
</html>
